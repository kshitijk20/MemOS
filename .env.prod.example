# Production settings for docker-compose.prod.yml. Copy to .env.prod and fill in.
# Never commit .env.prod.

# Public hostname pointing at this server, e.g. a free DuckDNS name (memos.duckdns.org)
# or <public-ip-with-dashes>.sslip.io. Caddy gets an HTTPS certificate for it.
DOMAIN=

# Database (only reachable inside the Docker network).
DB_NAME=memos
DB_USER=memos
# Generate with: openssl rand -base64 32
DB_PASSWORD=

# Required. Generate with: openssl rand -base64 64
JWT_SECRET=

# AI providers. Gemini is the default (free tier works, but allows ~5 chat requests/min total).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MEMOS_DEFAULT_AI_PROVIDER=GEMINI

# Follow-up rewriting costs one extra chat request per follow-up question. Off by default so
# the free Gemini quota goes further; set to true on a paid key.
MEMOS_RAG_QUERY_REWRITE_ENABLED=false

# Who can sign up. Set an invite code to make the server invite-only (share the code with the
# people you want), or turn registration off entirely once your accounts exist.
MEMOS_REGISTRATION_ENABLED=true
MEMOS_INVITE_CODE=

# Per-user limits (0 disables one). They stop a single account from using up the shared AI
# quota or filling the server's disk. One chunk is roughly a paragraph-sized section, ~5 KB stored.
MEMOS_LIMIT_QUESTIONS_PER_MINUTE=5
MEMOS_LIMIT_QUESTIONS_PER_DAY=200
MEMOS_LIMIT_INGESTIONS_PER_HOUR=20
MEMOS_LIMIT_MAX_DOCUMENTS=100
MEMOS_LIMIT_MAX_CHUNKS=20000

# Days of nightly database backups to keep in ./backups.
BACKUP_KEEP_DAYS=7
