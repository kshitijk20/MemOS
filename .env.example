# Copy this file to .env and fill in the values before running `docker compose up`

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=memos
DB_USER=memos
DB_PASSWORD=memos

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=please-change-this-secret-in-production-it-must-be-at-least-256-bits-long

# --- AI Providers ---
# REQUIRED (default provider, free): get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OPTIONAL: only needed if you switch MEMOS_DEFAULT_AI_PROVIDER to OPENAI (paid)
OPENAI_API_KEY=

# OPTIONAL: only needed if you switch MEMOS_DEFAULT_AI_PROVIDER to CLAUDE (paid)
ANTHROPIC_API_KEY=

# --- App behavior ---
MEMOS_DEFAULT_AI_PROVIDER=GEMINI
MEMOS_RAG_TOP_K=5
MEMOS_CORS_ALLOWED_ORIGINS=http://localhost:3000

SERVER_PORT=8080
