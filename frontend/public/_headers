# Security headers for every page, applied by Cloudflare to the static assets.
# The Content-Security-Policy only lets the page run its own scripts and talk to its own backend,
# so injected HTML can't load a script or send the stored sign-in token anywhere else. Inline
# styles stay allowed: the UI libraries set them at runtime. Update connect-src if the backend
# URL changes. Referrer-Policy: reset links carry a token in the URL; never send it as a referrer.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://memos-backend-4bkg.onrender.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
